# Veyra environment configuration (Phase 10). Copy to config/.env and edit.
# Prefix everything with VEYRA_. Never commit the real config/.env.

# --- Environment ----------------------------------------------------------
# dev (default, permissive) | test (CI) | prod (hard-fails on weak secrets)
VEYRA_ENVIRONMENT=dev

# --- Operator account (Phase 8) -------------------------------------------
# Seeded idempotently on first boot so you can sign into the dashboard.
VEYRA_ADMIN_EMAIL=you@example.com
VEYRA_ADMIN_PASSWORD=change-me

# --- Telegram bot (Phase 7/10) — ON HOLD ------------------------------------
# Browser + PWA alerts are the current channel, so these stay EMPTY.
# Only set a real token when enabling Telegram sends (also flip
# VEYRA_POSTBACK_TELEGRAM_ENABLED=True); prod then requires the token.
# Obtained from @BotFather when the time comes.
VEYRA_TELEGRAM_BOT_TOKEN=
VEYRA_TELEGRAM_CHAT_ID=
# Delivery is a paid feature; leave True to keep alert sending gated.
VEYRA_TELEGRAM_REQUIRE_SUBSCRIPTION=True
# Dry-run keeps sends logged-only; set False + real token to actually deliver.
VEYRA_TELEGRAM_DRY_RUN=True

# --- Telegram Stars billing (Phase 10) ------------------------------------
# Price of one month of premium, in Stars (currency XTR). Max 10_000.
VEYRA_STARS_PRICE_XTR=500
# Payload prefix must match the bot's invoice payload to validate payments.
VEYRA_STARS_PAYLOAD_PREFIX=veyra:premium:

# --- Auth (Phase 8/10) -----------------------------------------------------
# Session lifetime in seconds (default 7 days).
VEYRA_AUTH_SESSION_TTL_SECONDS=604800

# --- Paths ------------------------------------------------------------------
# VEYRA_DATA_DIR=data
# VEYRA_DATABASE_URL=sqlite:///data/veyra.db